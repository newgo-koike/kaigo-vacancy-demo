rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasDoc()   { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function me()       { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function myRole()   { return hasDoc() ? me().role : ''; }
    function isAdmin()  { return myRole() == 'admin'; }

    // ユーザー：本人は自分のdocのみ / 管理者は全部 / 病院は自病院の担当者を追加可
    match /users/{uid} {
      allow get:    if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list:   if isAdmin()
                    || (myRole() == 'hospital' && resource.data.hospitalId == me().hospitalId);
      allow create: if isAdmin()
                    || (myRole() == 'hospital'
                        && request.resource.data.role == 'hospital'
                        && request.resource.data.hospitalId == me().hospitalId);
      // 病院は自病院の担当者の「名前」だけ直せる。ID・役割・所属は触らせない。
      allow update: if isAdmin()
                    || (myRole() == 'hospital'
                        && resource.data.hospitalId == me().hospitalId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isAdmin();
    }

    // 施設：単一ページは公開（印刷・詳細）/ 一覧はログイン必須 / 更新は管理者・施設担当者
    match /facilities/{fid} {
      allow get:    if true;
      allow list:   if signedIn();
      allow write:  if isAdmin() || myRole() == 'facility';
    }

    // 法人：ログイン必須で閲覧 / 更新は管理者
    match /corporations/{cid} {
      allow read:   if signedIn();
      allow write:  if isAdmin();
    }

    // 検索ログ：記録は病院・管理者 / 閲覧は管理者のみ
    match /searchLogs/{lid} {
      allow create: if myRole() == 'hospital' || myRole() == 'admin';
      allow read, update, delete: if isAdmin();
    }

    // 空室相談（病院 → Meets Medical のチャット）：病院は自病院の相談だけ作成・閲覧・返信、管理者は全件
    function myHospital() { return me().hospitalId; }
    function isHospital() { return myRole() == 'hospital'; }
    match /consultations/{cid} {
      allow create: if isAdmin()
                    || (isHospital() && request.resource.data.hospitalId == myHospital()
                        && request.resource.data.createdBy == request.auth.uid);
      allow read:   if isAdmin() || (isHospital() && resource.data.hospitalId == myHospital());
      // 病院側は返信・修正に伴う更新（最終メッセージ・未読フラグ・件数・相談条件）だけ。所属は変えられず、ステータスは「取り下げ」にするときだけ変えられる。
      // 相談番号 caseNo は Cloud Functions（管理権限）だけが付ける。名前欄（caseLabel）は 2026-10-06 に廃止
      allow update: if isAdmin()
                    || (isHospital() && resource.data.hospitalId == myHospital()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['lastMessageAt','lastMessageBy','lastMessageText','unreadForAdmin','unreadForHospital','updatedAt','messageCount','conditions','status'])
                        && (request.resource.data.status == resource.data.status || request.resource.data.status == 'withdrawn'));
      allow delete: if isAdmin();

      match /messages/{mid} {
        allow read:   if isAdmin()
                      || (isHospital() && get(/databases/$(database)/documents/consultations/$(cid)).data.hospitalId == myHospital());
        // 相談本体と同じバッチで最初のメッセージを書くため getAfter（書き込み後の状態）で親を確認する
        allow create: if (isAdmin() && request.resource.data.by == 'admin')
                      || (isHospital() && request.resource.data.by == 'hospital'
                          && request.resource.data.uid == request.auth.uid
                          && getAfter(/databases/$(database)/documents/consultations/$(cid)).data.hospitalId == myHospital());
        // 病院側は自病院の発言だけ本文の修正・取り消しができる（誰の発言か・いつ送ったかは変えられない）
        allow update: if isAdmin()
                      || (isHospital() && resource.data.by == 'hospital'
                          && get(/databases/$(database)/documents/consultations/$(cid)).data.hospitalId == myHospital()
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt','deleted','deletedAt']));
        allow delete: if isAdmin();
      }
    }

    // 共通設定（meta/*）。病院が読む必要があるのは「パンフレット索引」と「自動返信の文面」だけ。
    // 通知先（LINE の ID・登録者名）や採番カウンターは管理者だけ（Cloud Functions は管理権限で読み書き）
    match /meta/brochures       { allow read: if signedIn(); allow write: if isAdmin(); }
    match /meta/consultSettings { allow read: if signedIn(); allow write: if isAdmin(); }
    match /meta/{doc} {
      allow read, write: if isAdmin();
    }

    // 申請：作成は誰でも（申請フォーム）/ 閲覧・更新は管理者
    match /applications/{aid} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
